<div class="container py-5"
     data-controller="recipe-suggestions"
     data-recipe-suggestions-recipes-value="<%= @results.map { |result|
       {
         id: result[:recipe].id,
         name: result[:recipe].name,
         image_url: result[:recipe].image_url
       }
     }.to_json %>">
  <h1 class="mb-4">What can you cook?</h1>

  <% if @results.any? %>
    <div class="row g-4">
      <% @results.each do |result| %>
        <div class="col-12 col-md-4">
          <%= link_to recipe_path(result[:recipe], ingredients: params[:ingredients]),
            class: "text-decoration-none" do %>
            <div class="card">
              <%= image_tag result[:recipe].image_url, class: "card-img-top", alt: result[:recipe].name %>

              <div class="card-body">
                <h5 class="card-title"><%= result[:recipe].name %></h5>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p>No matching recipes found. Try selecting different ingredients.</p>
  <% end %>
</div>

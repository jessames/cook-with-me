<main class="app-page recipe-show-page">

  <% if params[:ingredients].present? %>
    <%= link_to "← Back to Suggestions",
        results_recipes_path(
          ingredients: params[:ingredients],
          meal_type: params[:meal_type]
        ),
        class: "recipe-secondary-button recipe-back-button" %>
  <% end %>

  <h1><%= @recipe.name %></h1>

  <%= image_tag @recipe.image_url,
      alt: @recipe.name,
      class: "recipe-show-image" %>

  <% if user_signed_in? %>

    <% favorite = current_user.favorites.find_by(recipe: @recipe) %>

    <% if favorite %>

      <%= button_to "♥ Remove from Favorites",
          favorite_path(
            favorite,
            ingredients: params[:ingredients],
            meal_type: params[:meal_type]
          ),
          method: :delete,
          class: "recipe-secondary-button recipe-favorite-button" %>

    <% else %>

      <%= button_to "♡ Add to Favorites",
          recipe_favorites_path(
            @recipe,
            ingredients: params[:ingredients],
            meal_type: params[:meal_type]
          ),
          method: :post,
          class: "recipe-secondary-button recipe-favorite-button" %>

    <% end %>

  <% end %>

  <section class="card recipe-details-card">
    <div class="card-body">

      <h2>Ingredients</h2>

      <ul class="recipe-ingredients-list">
        <% @recipe.measurements.includes(:ingredient).each do |measurement| %>
          <li>
            <%= measurement.measure_value %>
            <%= measurement.ingredient.name %>
          </li>
        <% end %>
      </ul>

    </div>
  </section>

  <section class="card recipe-details-card">
    <div class="card-body">

      <h2>Instructions</h2>

      <ol class="recipe-instructions-list">
        <% @recipe.instructions.order(:instruction_number).each do |instruction| %>
          <li><%= instruction.instruction_content %></li>
        <% end %>
      </ol>

    </div>
  </section>

  <%= button_to "Cook With Me",
      recipe_cook_sessions_path(@recipe),
      class: "recipes-submit-button recipe-cook-button" %>

</main>

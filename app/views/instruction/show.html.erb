<h1><%= @recipe.name %></h1>
<p>Step <%= @step_number %> of <%= @steps.length %></p>
<p><%= @step %></p>

<% if @step_number > 1 %>
  <%= link_to "← Previous step",
      cook_session_instruction_path(@cook_session, @instruction, step: @step_number - 1) %>
<% end %>

<% if @step_number < @steps.length %>
  <%= link_to "Next step →",
      cook_session_instruction_path(@cook_session, @instruction, step: @step_number + 1) %>
<% end %>

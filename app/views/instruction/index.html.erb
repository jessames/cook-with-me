<% instructions = @instructions.to_a %>

<ol>
  <% instructions.each_with_index do |instruction, index| %>
    <li id="step-<%= instruction.id %>">
      <%= instruction.content %>

      <% if index.positive? %>
        <%= link_to "Previous step", "step-{instructions[index - 1].id}" %>
      <% end %>
    </li>
  <% end %>
</ol>

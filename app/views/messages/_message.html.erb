<% if message.role == "user" %>
  <div class="d-flex justify-content-end mb-3">
    <div class="chat-user-message rounded-4 p-3">
      <%= message.content %>
    </div>
  </div>

<% elsif message.role == "assistant" %>
  <div class="d-flex justify-content-start mb-3">
    <div class="chat-assistant-message rounded-4 p-3 text-start">
      <strong>✨ Cooking Cat</strong>
      <div class="mt-2">
        <%= message.content %>
      </div>
    </div>
  </div>
<% end %>

<%= turbo_frame_tag "cook_chat_frame" do %>
  <div class="d-flex flex-column h-100" style="min-height: 70vh;">

    <!-- MESSAGE HISTORY -->
    <div id="messages" class="flex-grow-1 overflow-auto p-3">

      <% if @messages.any? %>
        <%= render partial: "messages/message",
            collection: @messages,
            as: :message %>
      <% else %>
        <div class="text-center text-muted mt-5">
          <div><%= image_tag "cooking-cat-vector.png", alt: "Cooking Cat", style: "width: 3rem; height: auto;" %></div>
          <h5 class="mt-3">What can I help you with?</h5>
          <p>
            Ask me about ingredients, cooking techniques,
            substitutions, or anything happening in your kitchen.
          </p>
        </div>
      <% end %>

    </div>

    <!-- MESSAGE INPUT -->
    <div id="new_message_container" class="border-top p-3 mt-auto">
      <%= render "messages/form", message: Message.new %>

      <p class="text-center text-muted small mt-2 mb-0">
        Cooking Cat is here to help, one step at a time.
      </p>
    </div>

  </div>
<% end %>

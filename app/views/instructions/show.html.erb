<div class="container py-5 text-center">
  <h1 class="mb-4"><%= @recipe.name %></h1>

  <div class="card shadow-sm p-5 mb-4">
    <p class="text-muted mb-2">Step <%= @step_number %> of <%= @total_steps %></p>
     <div id="instruction_content" class="display-6 mb-4">
    <%= @step %>
  </div>
  </div>

  <div class="d-flex justify-content-between">
    <% if @prev_instruction %>
      <%= link_to "← Previous Step",
            cook_session_instruction_path(@cook_session, @prev_instruction),
            class: "btn btn-outline-secondary btn-lg" %>
    <% else %>
      <div></div>
    <% end %>

    <% if @next_instruction %>
      <%= link_to "Next Step →",
            cook_session_instruction_path(@cook_session, @next_instruction),
            class: "btn btn-primary btn-lg" %>
    <% else %>
      <%= link_to "Finish Cooking!",
            cook_session_path(@cook_session),
            data: { turbo_method: :delete },
            class: "btn btn-success btn-lg" %>
    <% end %>
  </div>


  <!-- CHAT CODE START -->
  <!-- CHAT BUTTON -->
  <div class="text-center mt-5 mb-4">
    <button
      type="button"
      class="btn btn-primary btn-lg"
      data-bs-toggle="modal"
      data-bs-target="#cookChatModal">
      ✨ Ask Cooking Cat
    </button>
  </div>

  <!-- CHAT MODAL -->
  <div
    class="modal fade"
    id="cookChatModal"
    tabindex="-1"
    aria-labelledby="cookChatModalLabel"
    aria-hidden="true">

    <div class="modal-dialog modal-fullscreen">
      <div class="modal-content">

        <div class="modal-header">
          <h5 class="modal-title" id="cookChatModalLabel">
            ✨ Ask Cooking Cat
          </h5>

          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close">
          </button>
        </div>

        <div class="modal-body p-0">
          <%= turbo_frame_tag "cook_chat_frame",
              src: cook_session_messages_path(
              @cook_session,
              instruction_id: @instruction.id
          ) %>
        </div>

      </div>
    </div>
  </div>

</div>

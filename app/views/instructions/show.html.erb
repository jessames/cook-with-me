<main class="app-page cooking-page text-center">

  <h1 class="mb-4"><%= @recipe.name %></h1>

  <div class="card cooking-instruction-card">
    <div class="card-body">

      <p class="text-muted mb-2">
        Step <%= @step_number %> of <%= @total_steps %>
      </p>

      <div class="display-6 mb-4">
        <%= @step %>
      </div>

    </div>
  </div>

  <div class="cooking-navigation">

    <% if @prev_instruction %>

      <%= link_to "← Previous Step",
          cook_session_instruction_path(@cook_session, @prev_instruction),
          class: "recipe-secondary-button" %>

    <% end %>

    <% if @next_instruction %>

      <%= link_to "Next Step →",
          cook_session_instruction_path(@cook_session, @next_instruction),
          class: "recipe-secondary-button" %>

    <% else %>

      <%= link_to "Finish Cooking!",
          cook_session_path(@cook_session),
          data: { turbo_method: :delete },
          class: "recipe-secondary-button" %>

    <% end %>

  </div>

  <!-- Chat Button -->
  <div class="cooking-chat-bottom">

    <button
      type="button"
      class="recipes-submit-button cooking-chat-button"
      data-bs-toggle="modal"
      data-bs-target="#cookChatModal">

      ✨ Ask Cooking Cat

    </button>

  </div>

  <!-- Chat Modal -->
  <div
    class="modal fade"
    id="cookChatModal"
    tabindex="-1"
    aria-labelledby="cookChatModalLabel"
    aria-hidden="true">

    <div class="modal-dialog modal-fullscreen">

      <div class="modal-content">

        <div class="modal-header">

          <h5 class="modal-title" id="cookChatModalLabel">
            ✨ Ask Cooking Cat
          </h5>

          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close">
          </button>

        </div>

        <div class="modal-body p-0">

          <%= turbo_frame_tag "cook_chat_frame",
              src: cook_session_messages_path(
                @cook_session,
                instruction_id: @instruction.id
              ) %>

        </div>

      </div>

    </div>

  </div>

</main>

<div class="container py-5 text-center">
  <h1 class="mb-4"><%= @recipe.name %></h1>

  <div class="card shadow-sm p-5 mb-4">
    <p class="text-muted mb-2">Step <%= @step_number %> of <%= @total_steps %></p>
    <div class="display-6 mb-4">
      <%= @step %>
    </div>
  </div>

  <div class="d-flex justify-content-between">
    <% if @prev_instruction %>
      <%= link_to "← Previous Step",
            cook_session_instruction_path(@cook_session, @prev_instruction),
            class: "btn btn-outline-secondary btn-lg" %>
    <% else %>
      <div></div>
    <% end %>

    <% if @next_instruction %>
      <%= link_to "Next Step →",
            cook_session_instruction_path(@cook_session, @next_instruction),
            class: "btn btn-primary btn-lg" %>
    <% else %>
      <%= link_to "Finish Cooking!",
            cook_session_path(@cook_session),
            data: { turbo_method: :delete },
            class: "btn btn-success btn-lg" %>
    <% end %>
  </div>
</div>

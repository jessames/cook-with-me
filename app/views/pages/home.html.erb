<% if user_signed_in? %>
  <div class="container">
    <h1>What's in your kitchen?</h1>
    <p>Add the ingredients you have, and we'll find recipes you can make.</p>

    <%= form_with url: results_recipes_path, method: :get, local: true do %>
      <div
        data-controller="ingredient-search"
        data-ingredient-search-ingredients-value="<%= @ingredients.as_json(only: [:id, :name, :image_url]).to_json %>"
      >
        <label for="ingredient-search">Search ingredients</label>

        <input
          type="text"
          id="ingredient-search"
          placeholder="Start typing an ingredient..."
          autocomplete="off"
          data-ingredient-search-target="input"
          data-action="input->ingredient-search#search"
        >

        <div
          data-ingredient-search-target="suggestions"
          class="ingredient-suggestions"
        ></div>

        <h2>Your ingredients</h2>

          <p data-ingredient-search-target="emptyMessage">
            You haven't added any ingredients yet.
          </p>

          <div
            class="selected-ingredients-grid"
            data-ingredient-search-target="selected"
          >
          </div>

        <div>
          <label for="serving-size">How many servings?</label>
          <input
            type="number"
            id="serving-size"
            name="serving_size"
            value="2"
            min="1"
            required
          >
        </div>

        <%= submit_tag "Show me recipes" %>
      </div>
    <% end %>
  </div>

<% else %>
  <div class="container">
    <h1>Let's get cooking!</h1>
    <p>Discover delicious recipes using ingredients you already have.</p>

    <%= link_to "Get Started Cooking", new_user_session_path %>
  </div>
<% end %>
